prisma/dev.db
prisma/dev.db-journal
prisma/*.db
# Generated Prisma client (regenerated on install/build)
**/node_modules/.prisma/

# ───────────────────────── Logs ─────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────────────────────── Testing / coverage ───────────────────
coverage/
.nyc_output/

# ───────────────────────── Caches / tooling ─────────────────────
.turbo/
.cache/
.eslintcache
.parcel-cache/

# ───────────────────────── OS / editor ──────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
