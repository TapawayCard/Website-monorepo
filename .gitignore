# ───────────────────────── Dependencies ─────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ───────────────────────── Env / secrets ────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# ───────────────────────── Next.js (frontend) ───────────────────
.next/
out/
next-env.d.ts
.vercel

# ───────────────────────── Backend build ────────────────────────
dist/
