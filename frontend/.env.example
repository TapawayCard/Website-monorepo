# Base URL of the TapAway backend API (the Railway service).
# Local dev: http://localhost:4000
# Production: https://your-backend.up.railway.app
BACKEND_API_URL="http://localhost:4000"

# Public base URL of the site itself (used for QR codes / profile links / vCards).
# Local: http://localhost:3000   Production: https://tapaway.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
