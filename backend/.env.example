# ─────────────────────────────────────────────
#  TapAway backend (Express API) — environment
# ─────────────────────────────────────────────

# PostgreSQL connection string.
# Railway → Postgres plugin → "Connect" tab → use the PUBLIC url for local dev,
# the private url works inside Railway.
DATABASE_URL="postgresql://user:password@host:5432/tapaway?schema=public"

# Secret used to sign auth JWTs. Generate with:  openssl rand -base64 32
# This MUST be the same on backend and frontend is NOT required — only the
# backend signs & verifies tokens, so keep it here.
AUTH_SECRET="change-me-to-a-long-random-string"

# Port the API listens on. Railway sets this automatically.
PORT=4000

# Comma-separated list of allowed browser origins for CORS.
# Server-to-server calls (the Next.js proxy) don't need this, but set it if you
# ever call the API directly from the browser. Example: https://tapaway.in
CORS_ORIGIN="http://localhost:3000"

# Public URL of the frontend. Used to build the link inside password-reset
# emails. Local: http://localhost:3000   Production: https://your-domain
FRONTEND_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────
# Order confirmation / password-reset emails, sent over the Resend HTTP API.
# Raw SMTP to Gmail is not used - cloud hosts like Railway routinely get their
# outbound SMTP connections silently dropped by Google, regardless of port.
# If RESEND_API_KEY is blank, emails are logged to the server console instead
# of being sent (handy for local testing).
# Get a key at resend.com; MAIL_FROM's domain must be verified there.
RESEND_API_KEY=""
MAIL_FROM="TapAway <no-reply@tapaway.in>"
# Where new-order notifications are sent (your TapAway inbox).
TAPAWAY_NOTIFY_EMAIL="support@tapaway.in"
