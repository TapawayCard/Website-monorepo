// TapAway — Prisma schema (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  passwordHash String
  privacyAcceptedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Forgot-password flow: a hash of the emailed token (never store it raw)
  // plus its expiry. Cleared once used or a new one is requested.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  profile Profile?
  orders  CardOrder[]
}

model Profile {
  id        String  @id @default(cuid())
  // The public handle: tapaway.in/u/<username>
  username  String  @unique
  fullName  String
  headline  String? // designation
  company   String?
  bio       String?
  avatarUrl String?
  accent    String  @default("#54b3e6") // profile theme color

  // Primary contact fields (shown as quick-action buttons)
  phone    String?
  email    String?
  whatsapp String?
  website  String?
  location String? // Google Maps link or address

  views Int @default(0)

  links Link[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Link {
  id        String   @id @default(cuid())
  // "social" links use a known platform key; "custom" links use label + url
  type      LinkType @default(CUSTOM)
  platform  String? // linkedin | instagram | facebook | twitter | youtube | payment | ...
  label     String
  url       String
  position  Int      @default(0)
  active    Boolean  @default(true)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum LinkType {
  SOCIAL
  CUSTOM
}

model CardOrder {
  id       String      @id @default(cuid())
  status   OrderStatus @default(PENDING)

  // Cart snapshot (array of configured items) + computed amount.
  items       Json
  amountPaise Int
  currency    String @default("INR")

  // Buyer details (guest checkout supported, so userId is optional).
  buyerName  String
  buyerEmail String
  buyerPhone String

  // Shipping address
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String @default("India")

  privacyConsent Boolean @default(false)

  // Manual UPI payment: buyer uploads a screenshot as proof, our team
  // verifies it against the UPI app before marking the order PAID.
  paymentProofData        String?   @db.Text
  paymentProofSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum OrderStatus {
  PENDING
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
}
